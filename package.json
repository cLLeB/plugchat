{
  "name": "plugchat",
  "version": "0.1.0",
  "description": "Drop-in, self-hosted, security-focused in-app messaging for any existing platform.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
