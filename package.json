{
  "name": "plugchat",
  "version": "0.1.1",
  "description": "Self-hosted in-app messaging you add to a platform that already exists: one endpoint, one tag, your own servers.",
  "keywords": [
    "chat",
    "messaging",
    "self-hosted",
    "web-component",
    "websocket",
    "end-to-end-encryption",
    "embeddable",
    "in-app-chat"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "plugchat": "bin/plugchat.js"
  },
  "files": [
    "bin",
    "server",
    "client",
    "starters",
    "docs",
    "bench",
    "Dockerfile",
    "LICENSE",
    "README.md",
    "examples",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md",
    "scripts",
    "!examples/host-app/data",
    "!examples/host-app/data-vendor",
    "!examples/frameworks/dist",
    "!starters/csharp/bin",
    "!starters/csharp/obj"
  ],
  "exports": {
    ".": {
      "types": "./server/index.d.ts",
      "default": "./server/index.js"
    },
    "./config": "./server/config.js",
    "./client": {
      "types": "./client/plugchat.d.ts",
      "default": "./client/plugchat.js"
    },
    "./element": {
      "types": "./client/element.d.ts",
      "default": "./client/element.js"
    },
    "./launcher": {
      "types": "./client/element.d.ts",
      "default": "./client/launcher.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./client/react.d.ts",
      "default": "./client/react.js"
    },
    "./vue": {
      "types": "./client/vue.d.ts",
      "default": "./client/vue.js"
    }
  },
  "scripts": {
    "start": "node bin/plugchat.js start",
    "demo": "node examples/host-app/server.js",
    "test": "node --test --test-timeout=20000 --test-force-exit",
    "test:postgres": "node --test --test-timeout=30000 --test-force-exit --test-concurrency=1",
    "check:types": "tsc -p .",
    "verify:starters": "node starters/verify.mjs",
    "bench": "node bench/load.mjs",
    "prepublishOnly": "npm test && npm run check:types",
    "verify:proxy": "node examples/behind-proxy/run.mjs --check",
    "openapi": "node scripts/openapi.mjs",
    "check:s3": "node scripts/check-s3.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vue": "^3.5.43"
  },
  "optionalDependencies": {
    "pg": "^8.23.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "author": "cLLeB (https://github.com/cLLeB)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cLLeB/plugchat.git"
  },
  "homepage": "https://github.com/cLLeB/plugchat#readme",
  "bugs": {
    "url": "https://github.com/cLLeB/plugchat/issues"
  }
}
